#!/usr/bin/env bash
# Tokosint web UI: scan analysis, sources (BBoT module metadata) and API keys.
#   bin/web [port]   start the local backend (default 8777), listens on 127.0.0.1 only
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$ROOT/bin/_env.sh"
require_install
exec "$ROOT/bbot/.venv/bin/python" "$ROOT/web/server.py" "${1:-8777}"
